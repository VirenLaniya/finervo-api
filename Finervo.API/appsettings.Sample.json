{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "LuckyPennySoftware.MediatR.License": "Fatal" // MediatR remains completely free to use for individuals and companies earning less than $5 million USD in annual revenue
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] [{UserId}] [{RequestMethod} {RequestPath}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/finervo_api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] [{CorrelationId}] [{UserId}] [{RequestMethod} {RequestPath}] {Message:lj} {Properties:j}{NewLine}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithProcessId"
    ],
    "Properties": {
      "Application": "Finervo.API"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=finervo;Username=postgres;Password=p@55w0rd"
  },
  "Jwt": {
    "Issuer": "FINERVO_JWT_ISSUER",
    "Audience": "FINERVO_JWT_AUDIENCE",
    "SecretKey": "FINERVO_JWT_SECRET",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  }
}